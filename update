#!/usr/bin/env bash

DOTFILES_DIR=$(dirname "$(readlink "$0" || echo "$0")")

DELETE=0
INSTALL=1
USE_DEFAULT=0
STOW_FOLDERS=()
DOTFILES=(.bash_aliases .zshrc .zshenv)

function parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -d | --delete)
                DELETE=1
                INSTALL=0
                shift
                ;;
            -u | --update)
                DELETE=1
                INSTALL=1
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -p | --private)
                USE_DEFAULT=1
                set_private
                shift
                ;;
            -s | --shared)
                USE_DEFAULT=1
                set_shared
                shift
                ;;
            -*)
                usage >&2
                exit 1
                ;;
            *)
                STOW_FOLDERS+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${USE_DEFAULT} -eq 1 ]]; then
        set_default
    fi

    if [[ ${#STOW_FOLDERS[@]} -eq 0 ]]; then
        usage >&2
        exit 1
    fi
}

function set_default() {
    STOW_FOLDERS=(vim ripgrep git lazygit tig worktrunk btop zsh nvim "${STOW_FOLDERS[@]}")
    case ${OSTYPE} in
        darwin*)
            STOW_FOLDERS+=(tig-mac)
            ;;
        linux-gnu*)
            STOW_FOLDERS+=(tig-linux)
            ;;
    esac
}

function unsupported_os() {
    echo "unsupported OSTYPE: ${OSTYPE}" >&2
    exit 1
}

function set_shared() {
    STOW_FOLDERS+=(tmux)
    case ${OSTYPE} in
        darwin*) ;;
        linux-gnu*)
            STOW_FOLDERS+=(bash)
            ;;
        *)
            unsupported_os
            ;;
    esac
}

function set_private() {
    STOW_FOLDERS+=(wakatime espanso herdr claude)
    case ${OSTYPE} in
        darwin*)
            STOW_FOLDERS+=(yazi ghostty ghostty-mac sketchybar aerospace)
            ;;
        linux-gnu*)
            STOW_FOLDERS+=(alacritty xmonad rofi nitrogen)
            ;;
        *)
            unsupported_os
            ;;
    esac
}

function usage() {
    cat << EOF
usage: $(basename "${0}") [--help]
       $(basename "${0}") [--update | --delete] (--private | --shared | dirs...)

options:
    --help,    -h     print this
    --update,  -u     delete and reinstall dotfiles
    --delete,  -d     delete dotfiles
    --shared,  -s     select dotfiles for a shared host
    --private, -p     select dotfiles for a private host

--private, --shared, or at least one dir is required.

EOF
}

function restore_file() {
    local file="${HOME}/$1"

    if [[ -f ${file}.backup && ! -L ${file}.backup ]]; then
        if [[ -L ${file} ]]; then
            rm -f "${file}"
        fi
        mv -f "${file}.backup" "${file}"
    fi
}

function backup_file() {
    local file="${HOME}/$1"

    if [[ -e ${file} && ! -L ${file} ]]; then
        mv -f "${file}" "${file}.backup"
    fi
}

function report() {
    if "$@"; then
        echo " ...   Done"
    else
        echo " ...   Failed"
    fi
}

function update() {
    if [[ ${DELETE} -eq 1 ]]; then
        for file in "${DOTFILES[@]}"; do
            restore_file "${file}"
        done
        for folder in "${STOW_FOLDERS[@]}"; do
            printf "Deleting   %-17s" "${folder}"
            report stow --dotfiles -t "${HOME}" -D "${folder}"
        done
        for dir in "${HOME}/.config" "${HOME}/.local"; do
            if [[ -d ${dir} ]]; then
                find "${dir}" -mindepth 1 -type d -empty -delete
            fi
        done
    fi

    if [[ ${INSTALL} -eq 1 ]]; then
        for file in "${DOTFILES[@]}"; do
            backup_file "${file}"
        done
        for folder in "${STOW_FOLDERS[@]}"; do
            printf "Installing %-17s" "${folder}"
            report stow --no-folding --ignore='\.DS_Store' --dotfiles -t "${HOME}" -S "${folder}"
        done
    fi
}

function main() {
    cd "${DOTFILES_DIR}/src" || exit
    parse_args "$@"
    update
}

main "$@"
