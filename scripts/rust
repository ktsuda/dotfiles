#!/usr/bin/env bash

set -e

sudo apt update
sudo apt install -y \
    curl \
    pkg-config \
    libfreetype6-dev \
    libfontconfig1-dev

# rust
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

${HOME}/.cargo/bin/rustup update stable
rustc --version   # >= 1.95

# rust cli tools
${HOME}/.cargo/bin/cargo install ripgrep # rg
${HOME}/.cargo/bin/cargo install fd-find # fd
${HOME}/.cargo/bin/cargo install tree-sitter-cli
${HOME}/.cargo/bin/cargo install zoxide # z
# ${HOME}/.cargo/bin/cargo install eza # eza
# ${HOME}/.cargo/bin/cargo install du-dust # dust
${HOME}/.cargo/bin/cargo install alacritty # alacritty
${HOME}/.cargo/bin/cargo install bob-nvim # bob
${HOME}/.cargo/bin/cargo install stylua --features luajit # stylua
${HOME}/.cargo/bin/cargo install wlctl # wlctl
${HOME}/.cargo/bin/cargo install kondo # kondo
${HOME}/.cargo/bin/cargo install dnsglobe # dnsglobe
${HOME}/.cargo/bin/cargo install grex # grex
