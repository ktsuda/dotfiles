Config { font = "UbuntuMono Nerd Font Bold 12"
       , additionalFonts = []
       , bgColor = "#1e1e2e"
       , fgColor = "#cdd6f4"
       , alpha = 255
       , position = TopHM 40 10 10 5 0
       , border = FullB
       , borderColor = "#cba6f7"
       , borderWidth = 3
       , textOffset = -1
       , iconOffset = -1
       , lowerOnStart = True
       , pickBroadest = False
       , persistent = False
       , hideOnStart = False
       , iconRoot = "."
       , allDesktops = True
       , overrideRedirect = True
       , commands = [ Run UnsafeStdinReader
                    , Run Com "/bin/sh" ["-c",
                                          "~/.local/share/xmobar/weather.sh"] "weather" 6000
                    , Run Volume "default" "Master" ["-t","󰕾  <volume>%",
                                                     "-L","20","-H","70",
                                                     "-n","#a6e3a1",
                                                     "-h","#f38ba8",
                                                     "-l","#74c7ec"] 20
                    , Run Network "enp86s0" ["-t","  <dev> ↓<rx>kB/s ↑<tx>kB/s",
                                             "-L","1000","-H","30000",
                                             "-n","#a6e3a1",
                                             "-h","#f38ba8",
                                             "-l","#74c7ec"] 20
                    , Run Cpu ["-t","' <total>%",
                               "-L","5","-H","50",
                               "-n","#a6e3a1",
                               "-h","#f38ba8",
                               "-l","#74c7ec"] 20
                    , Run Memory ["-t","  <usedratio>%",
                                  "-L","10","-H","70",
                                  "-n","#a6e3a1",
                                  "-h","#f38ba8",
                                  "-l","#74c7ec"] 20
                    , Run Swap ["-t","<usedratio>%",
                                "-L","1","-H","10",
                                "-n","#a6e3a1",
                                "-h","#f38ba8",
                                "-l","#74c7ec"] 50
                    , Run Date "  %Y.%m.%d %H:%M %a" "date" 300
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "  <action=`gtk-launch org.gnome.Settings`></action>  %UnsafeStdinReader% }\
                    \{ %weather%  %default:Master%  %enp86s0%  %cpu%  %memory% (%swap%)  %date%  "
       }
