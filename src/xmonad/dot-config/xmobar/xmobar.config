Config { font = "NotoMono Nerd Font 11"
       , additionalFonts = []
       , bgColor = "#1e1e2e"
       , fgColor = "#cdd6f4"
       , alpha = 255
       , position = TopHM 40 10 10 5 0
       , border = FullB
       , borderColor = "#cba6f7"
       , borderWidth = 3
       , textOffset = -1
       , iconOffset = -1
       , lowerOnStart = True
       , pickBroadest = False
       , persistent = False
       , hideOnStart = False
       , iconRoot = "."
       , allDesktops = True
       , overrideRedirect = True
       , commands = [ Run UnsafeStdinReader
                    , Run Weather "RJTI" ["-t","<skyCondition> <tempC>C <rh>%",
                                          "-L","18","-H","25",
                                          "-n","#a6e3a1",
                                          "-h","#f38ba8",
                                          "-l","#74c7ec"] 36000
                    , Run Network "enp86s0" ["-t","<dev> ↓<rx>kB/s ↑<tx>kB/s",
                                             "-L","1000","-H","30000",
                                             "-n","#a6e3a1",
                                             "-h","#f38ba8",
                                             "-l","#74c7ec"] 10
                    , Run Cpu ["-t","CPU <total>%",
                               "-L","5","-H","50",
                               "-n","#a6e3a1",
                               "-h","#f38ba8",
                               "-l","#74c7ec"] 10
                    , Run Memory ["-t","Mem <usedratio>%",
                                  "-L","10","-H","70",
                                  "-n","#a6e3a1",
                                  "-h","#f38ba8",
                                  "-l","#74c7ec"] 10
                    , Run Swap ["-t","Swap <usedratio>%",
                                "-L","1","-H","10",
                                "-n","#a6e3a1",
                                "-h","#f38ba8",
                                "-l","#74c7ec"] 10
                    , Run Com "uname" ["-s","-r"] "" 36000
                    , Run Date "%Y-%-m-%-d" "date" 10
                    , Run Date "%-H:%M" "time" 10
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = " %UnsafeStdinReader% : %cpu% : %memory% (%swap%) : %enp86s0% }\
                    \{ <fc=#89b4fa>%date%</fc> <fc=#cba6f7>%time%</fc> : %RJTI% : %uname% "
       }
