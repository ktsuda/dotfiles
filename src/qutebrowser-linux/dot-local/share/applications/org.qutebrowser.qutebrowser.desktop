[Desktop Entry]
Type=Application
Name=qutebrowser
GenericName=Web Browser
Comment=A keyboard-driven, vim-like browser based on Python and Qt
Exec=qutebrowser --untrusted-args %u
Icon=qutebrowser
Terminal=false
StartupNotify=true
StartupWMClass=qutebrowser
Categories=Network;WebBrowser;
Keywords=Browser
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/qute;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=qutebrowser
