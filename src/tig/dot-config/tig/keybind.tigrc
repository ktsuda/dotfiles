bind main R ?!git rebase -i %(commit)
bind diff R ?!git rebase -i %(commit)
bind main F ?+sh -c "~/.config/worktrunk/reword-msg.sh --fixup %(commit) 2>&1"
bind main M ?+sh -c "~/.config/worktrunk/reword-msg.sh %(commit) 2>&1"
bind diff F ?+sh -c "~/.config/worktrunk/reword-msg.sh --fixup %(commit) 2>&1"
bind diff M ?+sh -c "~/.config/worktrunk/reword-msg.sh %(commit) 2>&1"
bind generic y +sh -c "~/.local/share/tig/copy-to-clipboard.sh %(commit) 2>&1"
bind generic S view-stash
bind status C ?!wt step commit --stage none
bind status P ?+git push
bind main z ?!git stash
bind status z ?!git stash
bind generic <Ctrl-r> refresh
bind generic <Ctrl-Y> move-first-line
bind generic <Ctrl-E> move-last-line
